{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm check)",
      "Bash(pnpm fix)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec biome:*)",
      "Bash(turbo:*)",
      "Bash(npx ultracite:*)",
      "Bash(npx biome *)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git --no-pager log:*)",
      "Bash(git rev-parse --abbrev-ref HEAD)",
      "Read(~/.claude/**)",
      "Skill(agent-browser)",
      "Skill(agent-browser:*)",
      "Bash(agent-browser open *)",
      "Bash(agent-browser wait *)",
      "Bash(agent-browser snapshot *)",
      "Bash(agent-browser click *)",
      "Bash(agent-browser screenshot *)",
      "Bash(agent-browser set *)",
      "Bash(agent-browser close *)",
      "Bash(agent-browser fill *)",
      "Bash(agent-browser get *)",
      "Bash(agent-browser hover *)",
      "Bash(agent-browser skills *)",
      "Bash(agent-browser viewport *)",
      "Bash(agent-browser eval *)",
      "Bash(agent-browser reload *)",
      "Bash(agent-browser --help)"
    ],
    "additionalDirectories": ["/tmp"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-branch-write.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh\""
          }
        ]
      }
    ]
  }
}
